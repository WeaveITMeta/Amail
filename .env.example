# =============================================================================
# AMAIL Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings
# Only uncommented variables are required for basic operation

# =============================================================================
# REQUIRED - Server Configuration
# =============================================================================
HOST=127.0.0.1
PORT=4000

# =============================================================================
# REQUIRED - Ollama LLM (for AI agents)
# =============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# =============================================================================
# REQUIRED - Logging
# =============================================================================
LOG_LEVEL=info
RUST_LOG=amail=info,actix_web=info

# =============================================================================
# OPTIONAL - Mail Domain Configuration
# =============================================================================
# MAIL_DOMAIN=yourdomain.com
# MAIL_ORG_NAME=Your Organization

# =============================================================================
# OPTIONAL - Embedded Mail Server (built-in SMTP)
# =============================================================================
# MAIL_ENABLED=true
# MAIL_SMTP_PORT=2525
# MAIL_HOSTNAME=localhost

# =============================================================================
# OPTIONAL - External Mail Server (Stalwart)
# Only needed if using Stalwart instead of embedded mail server
# =============================================================================
# STALWART_URL=http://localhost:8080
# STALWART_ADMIN_USER=admin
# STALWART_ADMIN_PASS=your_password

# =============================================================================
# OPTIONAL - SMTP Configuration (Outbound)
# Only needed for sending emails externally
# =============================================================================
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# SMTP_STARTTLS=true

# =============================================================================
# OPTIONAL - Supabase Database
# If not set, Amail uses JSON config files in data/config/ instead
# =============================================================================
# Get your connection string from: Supabase Dashboard → Settings → Database
# DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# =============================================================================
# OPTIONAL - Redis (Task Queue)
# Improves performance for high-volume deployments
# =============================================================================
# REDIS_URL=redis://127.0.0.1:6379

# =============================================================================
# OPTIONAL - Agent Configuration
# =============================================================================
# Use full swarm (30+ agents) instead of core (6 agents)
# FULL_SWARM=false
# Agent response timeout in seconds
# AGENT_TIMEOUT=300

# =============================================================================
# OPTIONAL - Telegram Notifications (Human Review)
# =============================================================================
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_ENABLED=false
#
# --- Notification Settings ---
# TELEGRAM_NOTIFY_NEW_EMAIL=true
# TELEGRAM_NOTIFY_AI_DRAFT=true
# TELEGRAM_NOTIFY_ERRORS=true
#
# --- Quiet hours (no notifications) ---
# TELEGRAM_QUIET_START=22:00
# TELEGRAM_QUIET_END=08:00
#
# --- Priority filtering (low, normal, high, urgent) ---
# TELEGRAM_MIN_PRIORITY=normal

# =============================================================================
# OPTIONAL - Webhook Security
# Only needed if receiving webhooks from external mail server
# =============================================================================
# WEBHOOK_SECRET=your_secret_here

# =============================================================================
# OPTIONAL - Storage Configuration
# =============================================================================
# Where to store emails and attachments
# Priority: Supabase (if configured) → Local JSON files

# Supabase Storage (recommended for cloud)
# Requires DATABASE_URL to be set above
# SUPABASE_STORAGE_BUCKET=amail-attachments
# SUPABASE_ANON_KEY=your_anon_key

# Local storage paths (default fallback)
# STORAGE_EMAIL_PATH=./data/emails
# STORAGE_ATTACHMENT_PATH=./data/attachments

# =============================================================================
# OPTIONAL - P2P Attachments (Large Files)
# =============================================================================
# P2P_ATTACHMENTS_ENABLED=true
# P2P_SIZE_THRESHOLD_BYTES=10485760
# P2P_STORAGE_PATH=./data/p2p_attachments

# =============================================================================
# OPTIONAL - Compliance (Production deployments)
# Configure these for legal compliance in production
# =============================================================================
# COMPLIANCE_JURISDICTION=us
# CANSPAM_ORG_NAME=Your Organization
# CANSPAM_PHYSICAL_ADDRESS=123 Main Street, City, State 12345
# DMCA_AGENT_EMAIL=dmca@yourdomain.com
